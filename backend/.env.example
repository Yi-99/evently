# Copy to .env. Empty values mean "not configured".

# The LLM powers the chat orchestrator, venue research agents and deck generation.
# Claude by default; LLM_PROVIDER=openai switches everything to OpenAI (needs OPENAI_API_KEY below).
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
# Route individual purposes to another provider: comma-separated purpose=provider (anthropic|openai).
# Purposes: orchestrator (chat) | deck_outline, slide_render, slide_edit, presentation_edit (decks)
#           | venue_scout, venue_research, venue_summary, card_refine (venues)
#           | intake_extract (intake form).
# Groups: presentations, venues, chat, intake. A prefix also works (slide=openai covers slide_render + slide_edit).
# e.g. chat orchestration + slide decks on OpenAI, venue research on Claude:
# LLM_PROVIDER_OVERRIDES=orchestrator=openai,presentations=openai
LLM_PROVIDER_OVERRIDES=
# On billing/credential failures (e.g. Claude out of credits) retry on: auto (the other configured provider) | none | anthropic | openai.
LLM_FALLBACK=auto
# Seconds a provider that failed that way is skipped before it is tried again.
LLM_FALLBACK_COOLDOWN_S=600
# OpenAI models (defaults: the current flagship). Efforts come from LLM_ORCHESTRATOR_EFFORT / LLM_WORKER_EFFORT.
# OPENAI_ORCHESTRATOR_MODEL=gpt-6-astra
# OPENAI_WORKER_MODEL=gpt-6-astra

# Google Maps Platform key (Places API (New), Routes API, Geocoding API).
# GOOGLE_API_KEY is used as a fallback when GOOGLE_MAPS_API_KEY is unset.
GOOGLE_MAPS_API_KEY=
GOOGLE_API_KEY=

# Live transcription: set at least one (STT_PROVIDER=auto picks the first that is set),
# or leave all empty to use the browser's Web Speech API.
# OPENAI_API_KEY is also the key for the OpenAI LLM provider above.
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
STT_PROVIDER=auto

# Optional: WebRTC audio via LiveKit instead of the built-in WebSocket relay.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# App
ENVIRONMENT=development
SECRET_KEY=change-me
DATABASE_URL=sqlite+aiosqlite:///./evently.db
# REDIS_URL=redis://localhost:6379/0
# AUTH_REQUIRED=true

# Outreach: emails are drafted by the AI and sent only after you confirm.
# EMAIL_PROVIDER=auto picks Resend if RESEND_API_KEY is set, else SMTP if SMTP_HOST is set, else console (logs only).
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Luma public API key (requires Luma Plus): https://lu.ma -> Settings -> API
LUMA_API_KEY=

# Observability (OpenTelemetry → Dash0). Get endpoint + token from Dash0 → Settings → Auth tokens.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=evently-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
DASH0_DATASET=default

# Search (Elasticsearch): venue memory across events, transcript + chat search.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_PREFIX=evently
# ELASTICSEARCH_INFERENCE_ID=.elser-2-elasticsearch
